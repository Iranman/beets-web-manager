# syntax=docker/dockerfile:1

# Selects the upstream LinuxServer Beets base image at build time. Pin an
# explicit version (or, once validated, a digest) for anything built for
# production -- see docs/CONFIGURATION.md for why `latest` must never be the
# production default. Defaults to the tested production candidate.
ARG BEETS_BASE_IMAGE=lscr.io/linuxserver/beets:2.13.1
FROM ${BEETS_BASE_IMAGE}

# Immutable image provenance. Required, not optional: a blank/missing
# VCS_REF fails the build rather than silently producing an unlabeled
# image, and a later rebuild with new fixes must never be able to keep
# an earlier commit's label by omission.
ARG VCS_REF
RUN test -n "${VCS_REF}" || (echo "ERROR: VCS_REF build-arg is required and must not be blank" >&2 && exit 1)
LABEL org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/Iranman/beets-web-manager"

# Version-aware compatibility patch: applies the narrow Beets 2.4.0
# plugin-resolution fix only against exactly 2.4.0, skips it (upstream
# already contains the fix) on Beets >= 2.5.0, and fails the build for any
# other unsupported version. See docker/beets/apply_patches.py for the full
# policy; it never applies source changes based on a loose version match.
COPY docker/beets/ /opt/beets-patches/
RUN /lsiopy/bin/python3 /opt/beets-patches/apply_patches.py

# Create agent application, plugin, and LinuxServer custom service directories
RUN mkdir -p /opt/beets-web-manager-agent/beetsplug /custom-services.d

# Copy agent application code and bundled custom plugins
COPY backend/beets_control_agent.py /opt/beets-web-manager-agent/beets_control_agent.py
COPY backend/beets_startup_guard.py /opt/beets-web-manager-agent/beets_startup_guard.py
COPY beetsplug/ /opt/beets-web-manager-agent/beetsplug/

# Install S6 supervision service for the control agent and locked CLI wrapper.
# beets-agent-s6.sh runs the startup guard before exec'ing the control agent
# itself -- see docker/beets-agent-s6.sh for why this, not
# custom-cont-init.d, is the enforcement point.
COPY docker/beets-agent-s6.sh /custom-services.d/beets-control-agent
COPY docker/beet-locked /usr/local/bin/beet-locked
RUN rm -f /etc/s6-overlay/s6-rc.d/user/contents.d/svc-beets \
    && chmod +x /custom-services.d/beets-control-agent /usr/local/bin/beet-locked

# Environment configuration. BEETS_EXPECT_EXISTING_LIBRARY=1 by default: a
# rebuilt/redeployed engine image must refuse to silently accept a missing
# or empty database rather than treat it as a fresh install -- this is the
# exact failure mode of the 2026-07-28 production incident. A genuine new
# install must override this explicitly (BEETS_EXPECT_EXISTING_LIBRARY=0),
# not rely on it defaulting the other way.
ENV BEETS_AGENT_PORT=8338 \
    BEETSDIR=/config \
    PYTHONUNBUFFERED=1 \
    BEETS_EXPECT_EXISTING_LIBRARY=1

EXPOSE 8338

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD /lsiopy/bin/python3 -c "import urllib.request,os; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"BEETS_AGENT_PORT\",\"8338\")}/health', timeout=4).read()" || exit 1
