# Required owner/admin authentication.
# You do NOT need to invent BEETS_WEB_AUTH_TOKEN yourself: if it's left blank
# (or as the "changeme" placeholder below) and BEETS_WEB_PASSWORD is also
# unset, the app auto-generates a secure token on first start, persists it to
# /config/.auth_token, and prints it once to the startup log. Regenerate any
# time from System -> Authentication. Set BEETS_WEB_PASSWORD (32+ chars,
# matching BEETS_WEB_AUTH_MIN_LENGTH below, plus upper/lower/number/special)
# for native browser Basic Auth sign-in.
BEETS_WEB_AUTH_TOKEN=changeme
BEETS_WEB_PASSWORD=
BEETS_WEB_USERNAME=admin
BEETS_WEB_AUTH_DISABLED=0
BEETS_WEB_AUTH_MIN_LENGTH=32
BEETS_TRUSTED_PROXIES=
# Comma-separated host:port entries exempted from the outbound SSRF policy's
# private/internal-address block, enforced by backend/security.py in this
# (web-manager) process only. Public internet hosts (MusicBrainz, AcoustID,
# Discogs, etc.) never need to be listed here. Defaults to the internal Beets control agent.
# Add your own LAN integrations, e.g.:
#   BEETS_OUTBOUND_ALLOWLIST=beets:8338,your-plex-host:32400,your-lidarr-host:8686,bgutil-provider:4416,slskd:5030
BEETS_OUTBOUND_ALLOWLIST=beets:8338

# Core Beets Control Agent settings
BEETS_API_TOKEN=changeme
BEETS_API_URL=http://beets:8338
WEBCONTROL_PORT=8337
BEETS_ENABLE_LEGACY_LOCAL_SCAN=0
BEETS_SCAN_STATE_FILE=/web-manager-data/last_scan.txt

# AI provider keys
OPENAI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OPENROUTER_API_KEY=
AI_API_KEY=

# Plex and Arr services
PLEX_URL=
PLEX_TOKEN=
LIDARR_URL=
LIDARR_API_KEY=
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# Music metadata providers
ACOUSTID_API_KEY=
ACOUSTID_KEY=
DISCOGS_TOKEN=
DISCOGS_USER_TOKEN=
LISTENBRAINZ_TOKEN=

# SLSKD and Soulseek
SLSKD_SLSK_USERNAME=changeme
SLSKD_SLSK_PASSWORD=changeme
SLSKD_API_KEY=
SLSKD_API_KEY_FILE=/config/slskd_api_key

# Spotify playlist parsing
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# yt-dlp and direct-source helpers
YTDLP_COOKIE_FILE=/config/yt-dlp/cookies.txt
YTDLP_ALLOW_BROWSER_COOKIES=0
YTDLP_NETRC_FILE=/config/.netrc
YTDLP_PO_PROVIDER_URL=http://bgutil-provider:4416
YTDLP_JS_RUNTIMES=deno,node,quickjs
YTDLP_REMOTE_COMPONENTS=
YTDLP_INSTALL_DENO=0
YTDLP_INSTALL_SYSTEM_JS_RUNTIME=0
SPOTIFLAC_AUTO_INSTALL=0
SPOTIFLAC_CMD=

# Docker service credentials
PUID=1000
PGID=1000
BEETS_UID=1000
BEETS_GID=1000
DIGARR_INITIAL_PASSWORD=changeme
POSTGRES_PASSWORD=changeme

# Demo mode (optional): set to 1 to flag /api/setup/status as demo data.
# Seed a safe, self-synthesized demo library with:
#   python scripts/seed_demo_library.py
# No real music, no copyright concern, fully removable (delete the folder).
DEMO_MODE=0
