# Supported local environment for the backend test suite (docs/DEVELOPMENT.md).
# Mirrors CI's unit-tests job: Python 3.13 + requirements-dev.txt (which adds
# the pinned beets fixture package), the CLI tools some tests drive (sqlite3,
# ffmpeg, curl), and a non-root user like the GitHub runner, so permission
# tests run instead of skipping as root. Test-only; never published or
# deployed. The source tree is bind-mounted at /src at run time.
FROM python:3.14-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends sqlite3 ffmpeg curl \
 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-dev.txt /tmp/req/
RUN pip install --no-cache-dir -r /tmp/req/requirements-dev.txt
RUN useradd --create-home --uid 1000 tester
USER tester
ENV PYTHONFAULTHANDLER=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /src
# Fake CI-only token, same value and reason as .github/workflows/unit-tests.yml
# (set per run, not as an image ENV, so the image carries no token at all).
CMD ["env", "BEETS_WEB_AUTH_TOKEN=ci-unit-test-token-not-a-real-secret-0000000000", \
     "python", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py", "-v"]
